/*
 * HillSideView (shield hillside_view, 46 позиций) · ZMK
 * Dvorak и Диктор в прошивке поверх ВСТРОЕННЫХ раскладок ОС: US (QWERTY) и Russian (ЙЦУКЕН).
 *
 * Слои:  0 EN · 1 RU · 2 SC · 3 SYM · 4 NUM · 5 NUM-RU (усл.) · 6 NAV · 7 SYS (усл.)
 * Номера слоёв в привязках записаны цифрами, чтобы файл открывался в keymap editor.
 *
 * Порядок позиций (из boards/shields/hillside_view/hillside_view.dtsi):
 *   0-11  верхний ряд   (левая: внешняя→внутренняя, правая: внутренняя→внешняя)
 *   12-23 домашний ряд
 *   24-35 нижний ряд
 *   36-37 верхние клавиши больших пальцев (на 44-клавишной сборке не распаяны → &none)
 *   38-41 левые большие пальцы  (внешняя → внутренняя)
 *   42-45 правые большие пальцы (внутренняя → внешняя)
 *
 * ОС: только English (US) и Russian (ЙЦУКЕН).
 *   Ctrl+Shift+1 → выбрать английский, Ctrl+Shift+2 → выбрать русский.
 *   Windows: «Использовать один метод ввода для всех приложений» — включено (это по умолчанию).
 *
 * Большие пальцы: слева Gui · Shift · Ctrl · Num/NUM, справа Space/NAV · Bksp · Alt · Enter/SYM.
 * Смена языка: Num + Space одновременно.
 *
 * Требует модуль urob/zmk-auto-layer в config/west.yml (для &num_word).
 */

#include <behaviors.dtsi>
#include <behaviors/num_word.dtsi>
#include <behaviors/studio_unlock.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

&sk {
    release-after-ms = <1000>;
    quick-release;
};

&caps_word {
    continue-list = <UNDERSCORE MINUS BACKSPACE DELETE>;
};

&num_word {
    continue-list = <BSPC DEL DOT COMMA FSLH KP_SLASH PLUS MINUS STAR EQUAL PRCNT UNDERSCORE>;
};

/ {
    behaviors {
        // Защита от случайного нажатия, как в Miryoku: срабатывает только двойной тап
        td_boot: td_boot {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&none>, <&bootloader>;
        };
        td_reset: td_reset {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&none>, <&sys_reset>;
        };
        td_btclr: td_btclr {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&none>, <&bt BT_CLR>;
        };
        // тап — клавиша, удержание — слой
        ht: hold_tap_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&kp>;
        };
        // Space: тап — пробел, удержание — SYM. При быстрой печати всегда пробел.
        ht_spc: hold_tap_space {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&mo>, <&kp>;
        };
        // тап — numword, удержание — NUM
        ht_num: hold_tap_num {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&num_word>;
        };
        // Shift: тап — sticky shift, второй тап — caps word, удержание — обычный Shift
        smart_shft: smart_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&sk LSHFT>, <&caps_word>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        // RU: второй тап — системный Caps Lock (caps word сдвигает только A–Z)
        smart_shft_ru: smart_shift_ru {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&sk LSHFT>, <&kp CAPS>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        // Ь, с Shift — ъ
        ru_soft: ru_soft {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp M>, <&kp RBKT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        // «,», с Shift — «<» как в EN  (в ЙЦУКЕН «,» = Shift+/; «<» нет — ОС на миг в EN через ru_sym)
        ru_comma: ru_comma {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(FSLH)>, <&ru_sym LT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        // «.», с Shift — «>» как в EN  (в ЙЦУКЕН «.» = /; «>» нет — ОС на миг в EN через ru_sym)
        ru_dot: ru_dot {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp FSLH>, <&ru_sym GT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    macros {
        // Смена языка: выбрать раскладку в ОС и базовый слой. Каждое нажатие заново синхронизирует.
        lang_ru: lang_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&macro_tap &kp LC(LS(N2)) &to 1>;
        };
        lang_en: lang_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&macro_tap &kp LC(LS(N1)) &to 0>;
        };
        // RU: один английский символ = EN → символ → RU
        ru_sym: ru_sym {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <40>;
            tap-ms = <20>;
            bindings
                = <&macro_tap &kp LC(LS(N1))>
                , <&macro_param_1to1>
                , <&macro_tap &kp MACRO_PLACEHOLDER>
                , <&macro_tap &kp LC(LS(N2))>
                ;
        };
        // RU: модификаторы включают слой SC (английские буквы), чтобы хоткеи совпадали с EN
        ru_ctrl: ru_ctrl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mo 2 &kp LCTRL>
                , <&macro_pause_for_release>
                , <&macro_release &kp LCTRL &mo 2>
                ;
        };
        ru_alt: ru_alt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mo 2 &kp LALT>
                , <&macro_pause_for_release>
                , <&macro_release &kp LALT &mo 2>
                ;
        };
        ru_gui: ru_gui {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mo 2 &kp LGUI>
                , <&macro_pause_for_release>
                , <&macro_release &kp LGUI &mo 2>
                ;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        num_ru {
            if-layers = <1 4>;
            then-layer = <5>;
        };
        sys {
            if-layers = <4 6>;
            then-layer = <7>;
        };
        sym_ru {
            if-layers = <1 3>;
            then-layer = <8>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Смена языка: оба внутренних больших пальца (Num + Space)
        combo_lang_ru {
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            key-positions = <41 42>;
            bindings = <&lang_ru>;
            layers = <0>;
        };

        combo_lang_en {
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
            key-positions = <41 42>;
            bindings = <&lang_en>;
            layers = <1>;
        };

        // Все остальные комбо вертикальные: две клавиши одной колонки одним пальцем.
        // Ролла по одной колонке не бывает, поэтому idle 50 мс: скобку можно набрать сразу после буквы.

        // внутренние колонки, верх+дом (Y+I, F+D): ( )  — на NUM под ними + - и * /, не цифры
        combo_lpar {
            timeout-ms = <35>;
            require-prior-idle-ms = <50>;
            key-positions = <5 17>;
            bindings = <&kp LPAR>;
            layers = <0 1 4 5>;
        };

        combo_rpar {
            timeout-ms = <35>;
            require-prior-idle-ms = <50>;
            key-positions = <6 18>;
            bindings = <&kp RPAR>;
            layers = <0 1 4 5>;
        };

        // правая внутренняя колонка, дом+низ (D+B): _
        combo_under {
            timeout-ms = <35>;
            require-prior-idle-ms = <50>;
            key-positions = <18 30>;
            bindings = <&kp UNDERSCORE>;
            layers = <0 1>;
        };

        // безымянные, верх+дом: [ ]  (RU — через ru_sym)
        combo_lbkt_en {
            timeout-ms = <35>;
            require-prior-idle-ms = <50>;
            key-positions = <2 14>;
            bindings = <&kp LBKT>;
            layers = <0>;
        };

        combo_lbkt_ru {
            timeout-ms = <35>;
            require-prior-idle-ms = <50>;
            key-positions = <2 14>;
            bindings = <&ru_sym LBKT>;
            layers = <1>;
        };

        combo_rbkt_en {
            timeout-ms = <35>;
            require-prior-idle-ms = <50>;
            key-positions = <9 21>;
            bindings = <&kp RBKT>;
            layers = <0>;
        };

        combo_rbkt_ru {
            timeout-ms = <35>;
            require-prior-idle-ms = <50>;
            key-positions = <9 21>;
            bindings = <&ru_sym RBKT>;
            layers = <1>;
        };

        // безымянный левый, дом+низ: #  (RU — через ru_sym)
        combo_hash_en {
            timeout-ms = <35>;
            require-prior-idle-ms = <50>;
            key-positions = <14 26>;
            bindings = <&kp HASH>;
            layers = <0>;
        };

        combo_hash_ru {
            timeout-ms = <35>;
            require-prior-idle-ms = <50>;
            key-positions = <14 26>;
            bindings = <&ru_sym HASH>;
            layers = <1>;
        };

        // указательные, верх+дом: { }  (RU — через ru_sym)
        combo_lbrc_en {
            timeout-ms = <35>;
            require-prior-idle-ms = <50>;
            key-positions = <4 16>;
            bindings = <&kp LBRC>;
            layers = <0>;
        };

        combo_lbrc_ru {
            timeout-ms = <35>;
            require-prior-idle-ms = <50>;
            key-positions = <4 16>;
            bindings = <&ru_sym LBRC>;
            layers = <1>;
        };

        combo_rbrc_en {
            timeout-ms = <35>;
            require-prior-idle-ms = <50>;
            key-positions = <7 19>;
            bindings = <&kp RBRC>;
            layers = <0>;
        };

        combo_rbrc_ru {
            timeout-ms = <35>;
            require-prior-idle-ms = <50>;
            key-positions = <7 19>;
            bindings = <&ru_sym RBRC>;
            layers = <1>;
        };

        // средний левый, дом+низ (E+J): :  (в ЙЦУКЕН «:» = Shift+6)
        combo_colon_en {
            timeout-ms = <35>;
            require-prior-idle-ms = <50>;
            key-positions = <15 27>;
            bindings = <&kp COLON>;
            layers = <0>;
        };

        combo_colon_ru {
            timeout-ms = <35>;
            require-prior-idle-ms = <50>;
            key-positions = <15 27>;
            bindings = <&kp LS(N6)>;
            layers = <1>;
        };

        // средний правый, дом+низ (T+W): ;  (в ЙЦУКЕН «;» = Shift+4)
        combo_semi_en {
            timeout-ms = <35>;
            require-prior-idle-ms = <50>;
            key-positions = <20 32>;
            bindings = <&kp SEMI>;
            layers = <0>;
        };

        combo_semi_ru {
            timeout-ms = <35>;
            require-prior-idle-ms = <50>;
            key-positions = <20 32>;
            bindings = <&kp LS(N4)>;
            layers = <1>;
        };

        // средние, верх+дом: ? (.+E) и ! (C+T)  (в ЙЦУКЕН ? = Shift+7, ! = Shift+1)
        combo_qmark_en {
            timeout-ms = <35>;
            require-prior-idle-ms = <50>;
            key-positions = <3 15>;
            bindings = <&kp QMARK>;
            layers = <0>;
        };

        combo_qmark_ru {
            timeout-ms = <35>;
            require-prior-idle-ms = <50>;
            key-positions = <3 15>;
            bindings = <&kp LS(N7)>;
            layers = <1>;
        };

        combo_excl_en {
            timeout-ms = <35>;
            require-prior-idle-ms = <50>;
            key-positions = <8 20>;
            bindings = <&kp EXCL>;
            layers = <0>;
        };

        combo_excl_ru {
            timeout-ms = <35>;
            require-prior-idle-ms = <50>;
            key-positions = <8 20>;
            bindings = <&kp LS(N1)>;
            layers = <1>;
        };

        // левый указательный, дом+низ (U+K): '  (в ЙЦУКЕН нет — через ru_sym)
        combo_sqt_en {
            timeout-ms = <35>;
            require-prior-idle-ms = <50>;
            key-positions = <16 28>;
            bindings = <&kp SQT>;
            layers = <0>;
        };

        combo_sqt_ru {
            timeout-ms = <35>;
            require-prior-idle-ms = <50>;
            key-positions = <16 28>;
            bindings = <&ru_sym SQT>;
            layers = <1>;
        };

        // правый указательный, дом+низ (H+M): "  (в ЙЦУКЕН " = Shift+2)
        combo_dqt_en {
            timeout-ms = <35>;
            require-prior-idle-ms = <50>;
            key-positions = <19 31>;
            bindings = <&kp DQT>;
            layers = <0>;
        };

        combo_dqt_ru {
            timeout-ms = <35>;
            require-prior-idle-ms = <50>;
            key-positions = <19 31>;
            bindings = <&kp LS(N2)>;
            layers = <1>;
        };

        // внутренние колонки, дом+низ: - (I+X) и / (D+B)  (в ЙЦУКЕН / = Shift+\)
        combo_minus {
            timeout-ms = <35>;
            require-prior-idle-ms = <50>;
            key-positions = <17 29>;
            bindings = <&kp MINUS>;
            layers = <0 1>;
        };

        combo_fslh_en {
            timeout-ms = <35>;
            require-prior-idle-ms = <50>;
            key-positions = <21 33>;
            bindings = <&kp FSLH>;
            layers = <0>;
        };

        combo_fslh_ru {
            timeout-ms = <35>;
            require-prior-idle-ms = <50>;
            key-positions = <21 33>;
            bindings = <&kp LS(BSLH)>;
            layers = <1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // 0 · Dvorak поверх US
        en_layer {
            display-name = "EN";
            bindings = <
        &kp TAB          &none            &kp COMMA        &kp DOT          &kp P            &kp Y   &kp F            &kp G            &kp C            &kp R            &kp L            &none
        &kp ESC          &kp A            &kp O            &kp E            &kp U            &kp I   &kp D            &kp H            &kp T            &kp N            &kp S            &none
        &none            &none            &kp Q            &kp J            &kp K            &kp X   &kp B            &kp M            &kp W            &kp V            &kp Z            &none
                                                                                             &none                               &none
                                          &kp LGUI         &smart_shft      &kp LCTRL        &ht_num 4 4        &ht_spc 3 SPACE  &kp BSPC         &kp LALT         &ht 6 RET
            >;
        };

        // 1 · Диктор (буквы Ru pro, гласные А О Е И У) поверх ЙЦУКЕН
        ru_layer {
            display-name = "RU";
            bindings = <
        &kp TAB          &kp W            &ru_comma        &ru_dot          &ru_soft         &kp Z   &kp P            &kp D            &kp R            &kp L            &kp X            &kp I
        &kp ESC          &kp F            &kp J            &kp T            &kp B            &kp E   &kp K            &kp Y            &kp N            &kp C            &kp H            &kp Q
        &kp GRAVE        &kp A            &kp SQT          &kp LBKT         &kp S            &kp DOT   &kp COMMA        &kp V            &kp G            &kp U            &kp SEMI         &kp O
                                                                                             &none                               &none
                                          &ru_gui          &smart_shft_ru   &ru_ctrl         &trans             &trans           &trans           &ru_alt          &trans
            >;
        };

        // 2 · английские буквы под Ctrl/Alt/Gui в русском режиме
        sc_layer {
            display-name = "SC";
            bindings = <
        &trans           &none            &kp COMMA        &kp DOT          &kp P            &kp Y   &kp F            &kp G            &kp C            &kp R            &kp L            &none
        &trans           &kp A            &kp O            &kp E            &kp U            &kp I   &kp D            &kp H            &kp T            &kp N            &kp S            &none
        &none            &none            &kp Q            &kp J            &kp K            &kp X   &kp B            &kp M            &kp W            &kp V            &kp Z            &none
                                                                                             &trans                              &trans
                                          &trans           &trans           &trans           &trans             &trans           &trans           &trans           &trans
            >;
        };

        // 3 · только символы, которых нет на базовом слое, в комбо и на NUM; все на домашнем ряду
        sym_layer {
            display-name = "SYM";
            bindings = <
        &none            &none            &none            &none            &none            &none   &none            &none            &none            &none            &none            &none
        &none            &kp TILDE        &kp PIPE         &kp GRAVE        &kp BSLH         &none   &none            &kp DLLR         &kp AMPS         &kp CARET        &kp AT           &none
        &none            &none            &none            &none            &none            &none   &none            &none            &none            &none            &none            &none
                                                                                             &trans                              &trans
                                          &trans           &trans           &trans           &trans             &trans           &trans           &trans           &trans
            >;
        };

        // 4 · цифры левой рукой, 0 на мизинце; справа * = и F-клавиши (F10–F12 в пятом столбце); Ctrl и Alt там же, где на основном слое
        num_layer {
            display-name = "NUM";
            bindings = <
        &none            &kp PRCNT        &kp N7           &kp N8           &kp N9           &kp PLUS   &kp STAR         &kp F7           &kp F8           &kp F9           &kp F10          &td_boot
        &none            &kp N0           &kp N4           &kp N5           &kp N6           &none   &none            &kp F4           &kp F5           &kp F6           &kp F11          &none
        &none            &none            &kp N1           &kp N2           &kp N3           &kp DOT   &kp EQUAL        &kp F1           &kp F2           &kp F3           &kp F12          &none
                                                                                             &trans                              &trans
                                          &trans           &trans           &kp LCTRL        &trans             &trans           &trans           &kp LALT         &trans
            >;
        };

        // 5 · условный: RU + NUM, точка ЙЦУКЕН
        num_ru_layer {
            display-name = "NUM-RU";
            bindings = <
        &trans           &trans           &trans           &trans           &trans           &trans   &trans           &trans           &trans           &trans           &trans           &trans
        &trans           &trans           &trans           &trans           &trans           &trans   &trans           &trans           &trans           &trans           &trans           &trans
        &trans           &trans           &trans           &trans           &trans           &kp FSLH   &trans           &trans           &trans           &trans           &trans           &trans
                                                                                             &trans                              &trans
                                          &trans           &trans           &trans           &trans             &trans           &trans           &trans           &trans
            >;
        };

        // 6 · навигация
        nav_layer {
            display-name = "NAV";
            bindings = <
        &td_boot         &lang_en         &lang_ru         &none            &none            &none   &kp C_VOL_UP     &kp HOME         &kp PSCRN        &kp PG_UP        &kp SLCK         &kp CAPS
        &none            &kp LGUI         &kp LALT         &kp LCTRL        &kp LSHFT        &none   &kp C_MUTE       &kp LEFT         &kp UP           &kp RIGHT        &kp INS          &mt LCTRL K_APP
        &none            &kp LC(Z)        &kp LC(X)        &kp LC(C)        &kp LC(V)        &kp LC(LS(Z))   &kp C_VOL_DN     &kp END          &kp DOWN         &kp PG_DN        &kp PAUSE_BREAK  &kp DEL
                                                                                             &trans                              &trans
                                          &trans           &trans           &trans           &trans             &trans           &trans           &trans           &trans
            >;
        };

        // 7 · условный: NAV + NUM
        sys_layer {
            display-name = "SYS";
            bindings = <
        &td_btclr        &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4   &none            &none            &none            &none            &none            &none
        &td_boot         &out OUT_USB     &out OUT_BLE     &studio_unlock   &none            &none   &none            &none            &none            &none            &none            &td_boot
        &td_reset        &none            &none            &none            &none            &none   &kp C_PREV       &kp C_PP         &kp C_NEXT       &none            &none            &td_reset
                                                                                             &trans                              &trans
                                          &trans           &trans           &trans           &trans             &trans           &trans           &trans           &trans
            >;
        };

        // 8 · условный: RU + SYM — каждый символ сам переключает ОС на миг в EN (\ есть в ЙЦУКЕН)
        sym_ru_layer {
            display-name = "SYM-RU";
            bindings = <
        &trans           &trans           &trans           &trans           &trans           &trans   &trans           &trans           &trans           &trans           &trans           &trans
        &trans           &ru_sym TILDE    &ru_sym PIPE     &ru_sym GRAVE    &kp BSLH         &trans   &trans           &ru_sym DLLR     &ru_sym AMPS     &ru_sym CARET    &ru_sym AT       &trans
        &trans           &trans           &trans           &trans           &trans           &trans   &trans           &trans           &trans           &trans           &trans           &trans
                                                                                             &trans                              &trans
                                          &trans           &trans           &trans           &trans             &trans           &trans           &trans           &trans
            >;
        };
    };
};
